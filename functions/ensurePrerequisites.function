#!/usr/bin/env bash
#
# General-purpose function to install prerequisites if they don't exist

function ensurePrerequisites() {
    local OPTIND tookAction

    help() {
        cat <<EOF
ensurePrerequisites -- General-purpose function: ensure prerequisites are satisfied.

Ensures that preferences are set, 'rg' and 'jq' are installed, and that
the Playwright scraper is ready. Automatically run before the main part
of any script.

USAGE:
    ensurePrerequisites [OPTIONS...]

OPTIONS:
    -h      Print this message.
EOF
    }

    while getopts ":h" opt; do
        case $opt in
        h)
            help
            waitUntil -k
            return
            ;;
        \?)
            printf "\n==> [${YELLOW}Warning${NO_COLOR}] Invalid " >&2
            printf "${YELLOW}-$OPTARG${NO_COLOR} option in: " >&2
            printf "${YELLOW}$0>ensurePrerequisites${NO_COLOR}.\n" >&2
            ;;
        :)
            printf "\n==> [${RED}Error${NO_COLOR}] Option ${RED}-$OPTARG${NO_COLOR} " >&2
            printf "in: ${RED}$0>ensurePrerequisites${NO_COLOR} requires an argument.\n" >&2
            ;;
        esac
    done
    shift $((OPTIND - 1))

    if [[ -n $NEED_PREFS ]]; then
        cat <<EOT
Welcome to IMDb_xref!

First, I'll let you choose the interaction style you prefer. Then I'll check
that all prerequisites are installed.

EOT
        source ./setPreferences.sh
        # shellcheck disable=SC1090 # configFile is defined
        source "$configFile"
    fi

    # Make sure we can execute rg
    if ! checkForExecutable -q rg; then
        installRipgrep
        tookAction="yes"
    fi

    # Make sure jq is available
    if ! checkForExecutable -q jq; then
        printf "==> 'jq' is required but not installed.\n"
        printf "    Install it with: brew install jq\n"
        exit 1
    fi

    # Make sure uv is available
    if ! checkForExecutable -q uv; then
        printf "==> 'uv' is required but not installed.\n"
        printf "    Install it from: https://docs.astral.sh/uv/\n"
        exit 1
    fi

    # Make sure scraper dependencies are installed
    if [[ ! -d "scraper/.venv" ]]; then
        printf "==> Installing scraper dependencies...\n"
        uv sync --directory scraper 2>&1
        tookAction="yes"
    fi

    # Make sure playwright CLI is available
    if ! checkForExecutable -q playwright; then
        printf "==> 'playwright' is required but not installed.\n"
        printf "    Install it with: npm install -g playwright\n"
        exit 1
    fi

    # Make sure Playwright chromium browser is installed
    # Check common cache dirs for the chromium binary
    pwCache=""
    case "$(uname)" in
    Darwin) pwCache="${HOME}/Library/Caches/ms-playwright" ;;
    *) pwCache="${HOME}/.cache/ms-playwright" ;;
    esac
    pwInstalled="no"
    for dir in "$pwCache"/chromium-*/; do
        if ls "$dir"chrome-* >/dev/null 2>&1; then
            pwInstalled="yes"
            break
        fi
    done
    if [[ $pwInstalled != "yes" ]]; then
        printf "==> Installing Playwright chromium browser...\n"
        playwright install chromium 2>&1
        tookAction="yes"
    fi

    # Let us know we were successful
    if [[ -n $tookAction ]]; then
        printf "\n==> Prerequisites successfully installed.\n"
        waitUntil -k "Hit any key to continue, '^C' to quit."
        clear
    fi
}

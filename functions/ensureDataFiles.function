#!/usr/bin/env bash
#
# General-purpose function to generate data files if they don't exist

function ensureDataFiles() {
    local OPTIND
    local ASSUME_YES TCONST_FILE
    local -a genArgs

    help() {
        cat <<EOF
ensureDataFiles -- General-purpose: Generate Xref data files if any don't exist.

Runs generateXrefData.sh and hides all its output except '==> Previously,'

USAGE:
    ensureDataFiles [OPTIONS...] [TCONST_FILE]

OPTIONS:
    -h      Print this message.
    -y      Yes -- Generate without asking. For callers where the answer is
            already known, e.g. demo.command, where the user has no basis on
            which to decide and the corpus is small enough to build in seconds.

TCONST_FILE, if given, is passed to generateXrefData.sh instead of letting it
process every *.tconst file in the directory.

EXAMPLES:
    ensureDataFiles
    ensureDataFiles -y Contrib/demo.tconst
EOF
    }

    while getopts ":hy" opt; do
        case $opt in
        h)
            help
            waitUntil -k
            return
            ;;
        y)
            ASSUME_YES="yes"
            ;;
        \?)
            printf "\n==> [${YELLOW}Warning${NO_COLOR}] Invalid " >&2
            printf "${YELLOW}-$OPTARG${NO_COLOR} option in: " >&2
            printf "${YELLOW}$0>ensureDataFiles${NO_COLOR}.\n" >&2
            ;;
        :)
            printf "\n==> [${RED}Error${NO_COLOR}] Option ${RED}-$OPTARG${NO_COLOR} " >&2
            printf "in: ${RED}$0>ensureDataFiles${NO_COLOR} requires an argument.\n" >&2
            ;;
        esac
    done
    shift $((OPTIND - 1))
    TCONST_FILE="$1"

    if [[ -n $TCONST_FILE ]] && [[ ! -e $TCONST_FILE ]]; then
        printf "==> [${RED}Error${NO_COLOR}] Missing tconst file: $TCONST_FILE\n" >&2
        exit 1
    fi

    genArgs=(-q)
    [[ -n $TCONST_FILE ]] && genArgs+=("$TCONST_FILE")

    if [[ -n $ASSUME_YES ]]; then
        printf "==> Generating the cast member data files. This takes a few seconds.\n"
        ./generateXrefData.sh "${genArgs[@]}" | rg --color never '==> Previously,'
        clear
        return
    fi

    printf "==> I didn't find a cast member file normally generated by generateXrefData.sh\n"
    if waitUntil "$YN_PREF" -Y "    Shall I generate that file for you?"; then
        ./generateXrefData.sh "${genArgs[@]}" | rg --color never '==> Previously,'
        printf "\n==> Data files successfully generated."
        waitUntil -k "Hit any key to clear screen and continue, '^C' to quit."
        clear
    else
        printf "==> [${RED}Error${NO_COLOR}] Missing required data files.\n" >&2
        printf "    Please run ./generateXrefData.sh, then re-run this script.\n" >&2
        exit 1
    fi
}
